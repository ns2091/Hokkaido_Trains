switch(FEAT_TRAINS, SELF, sw_739_6cars_artpart, extra_callback_info1) {
    0..5: return emu739_6cars;
	default: return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item(FEAT_TRAINS, emu739_6cars) {
    property {
        name: string(STR_739_6CARS_NAME);
        introduction_date: date(2027, 3, 1);
        climates_available: ALL_CLIMATES;
        running_cost_base: RUNNING_COST_ELECTRIC;
        ai_special_flag: AI_FLAG_PASSENGER;
        engine_class: ENGINE_CLASS_ELECTRIC;
        model_life: VEHICLE_NEVER_EXPIRES;
        track_type: RAILTYPE_ELECTRIC;
        sprite_id: SPRITE_ID_NEW_TRAIN;
        non_refittable_cargo_classes: bitmask();
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        vehicle_life: 30;
        reliability_decay: 20;
        // cargo_allow_refit: [];
        // cargo_disallow_refit: [];
        loading_speed: param_loading_commuter;
        cost_factor: 44;
        running_cost_factor: 134;
        speed: 130 km/h;
        refit_cost: 0;
        power: 230 * 4 * 2 kW;
        dual_headed: 0;
        cargo_capacity: param_capacity_commuter;
        weight: 220 ton;
        ai_engine_rank: 0;
        tractive_effort_coefficient: 0.2;
        air_drag_coefficient: 0.06;
        length: 8;
        // bitmask_vehicle_info: 0;
        // variant_group: emu739_3cars;
    }
	
    graphics {
		purchase          : set_739_purchase;

        // Below items are depends on consist
        default           : sw_739_6cars_gfx_main;
        can_attach_wagon  :	sw_739_6cars_can_attach_wagon;
		additional_text   : string(STR_739_6CARS_DESC);
        // cargo_subtype_text: sw_739_6cars_subtypes;
		articulated_part  : sw_739_6cars_artpart;
    }
}
